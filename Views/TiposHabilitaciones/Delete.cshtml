@model GestionHotelera.ViewModels.TipoHabilitacionViewModel

@{
	ViewData["Title"] = "Eliminar Tipo de Habilitación";
}

<div class="container mt-4">
	<div class="row">
		<div class="col-md-8 offset-md-2">
			<h1 class="text-danger">Confirmar Eliminación</h1>

			<div class="alert alert-warning mt-3">
				¿Está seguro de que desea eliminar este tipo de habilitación?
			</div>

			<div class="card">
				<div class="card-body">
					<dl class="row">
						<dt class="col-3">Nombre</dt>
						<dd class="col-9">@Model.Nombre</dd>

						<dt class="col-3">Descripción</dt>
						<dd class="col-9">@Model.Descripcion</dd>

						<dt class="col-3">Precio Base</dt>
						<dd class="col-9">@Model.PrecioBase.ToString("C2")</dd>

						<dt class="col-3">Estado</dt>
						<dd class="col-9">
							@if (Model.Activo)
							{
								<span class="badge bg-success">Activo</span>
							}
							else
							{
								<span class="badge bg-secondary">Inactivo</span>
							}
						</dd>
					</dl>

					<form method="post" class="mt-3">
						<button type="submit" class="btn btn-danger">Eliminar</button>
						<a href="@Url.Action("Index")" class="btn btn-secondary">Cancelar</a>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>
